# Production: public TLS reverse proxy must forward to localhost:8080.
APP_ORIGIN=https://keepfin.example.com
POSTGRES_PASSWORD=replace-with-a-random-password
# Generate four different passwords (openssl rand -hex 32).
KEEPFIN_DB_PASSWORD=
KEEPFIN_MIGRATION_DB_PASSWORD=
AUTH_DB_PASSWORD=
AUTH_MIGRATION_DB_PASSWORD=
# Exact address/CIDR of the TLS proxy as seen by the frontend container.
# The Docker host gateway in the default production network is 172.30.80.1/32.
TRUSTED_EDGE_PROXY_CIDR=
# Per-minute budgets. Go counters are per process; auth counters use PostgreSQL.
API_IP_RATE_LIMIT=600
API_USER_RATE_LIMIT=300
AUTH_SESSION_RATE_LIMIT=900
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Market prices and historical FX (required for portfolio valuation)
EODHD_API_TOKEN=

# Private holdings search. Keep this key on the backend only.
# Generate with: openssl rand -hex 32
TYPESENSE_API_KEY=
# When running Go outside Compose:
# TYPESENSE_URL=http://your-private-typesense:8108

# Optional second provider (US instruments and daily FX)
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_PROVIDER=eodhd
