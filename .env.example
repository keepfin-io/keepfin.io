# Production: public TLS reverse proxy must forward to localhost:8080.
APP_ORIGIN=https://keepfin.example.com
POSTGRES_PASSWORD=replace-with-a-random-password
AUTH_DATABASE_URL=postgres://postgres:URL_ENCODED_PASSWORD@postgres:5432/keepnode
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Market prices and historical FX (required for portfolio valuation)
EODHD_API_TOKEN=

# Private holdings search. Keep this key on the backend only.
# Generate with: openssl rand -hex 32
TYPESENSE_API_KEY=
# When running Go outside Compose:
# TYPESENSE_URL=http://your-private-typesense:8108

# Optional second provider (US instruments and daily FX)
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_PROVIDER=eodhd
